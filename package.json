{
	"name": "svelte-live-fires",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"data": "python3 scripts/fetch_fires.py",
		"data:active": "python3 scripts/fetch_fires.py --skip-effis",
		"data:smoke": "scripts/.venv/bin/python scripts/fetch_smoke.py",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/d3-geo": "^3.1.0",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"d3-geo": "^3.1.1",
		"d3-scale": "^4.0.2",
		"maplibre-gl": "^6.0.0",
		"pym.js": "^1.3.2"
	}
}
